<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Task Manager</title>
    <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900 text-white">
        <h1 class="p-10 uppercase text-xl font-bold">SafeNote</h1>
        <div class="p-10">
            <form action="/create" method="post">
                <input class="block w-full rounded-md mt-2 px-4 py-2 bg-zinc-800" type="text" name="title" id="name" placeholder="Title">
                <textarea class="mt-2 block w-full rounded-md px-4 py-2 resize-none bg-zinc-800" placeholder="Write Your Task Details" id="" name="details"></textarea>
                <input type="submit" value="Create Task" class="bg-blue-600 px-4 mt-3 py-2 rounded-md">
            </form>
        </div>
        <div class="flex gap-2 mx-10 pt-10 flex-wrap">
            <% if (typeof files !== 'undefined' && files.length > 0) { %>
                <% files.forEach(function(val) {  %>
                    <div class="task w-72 rounded-md px-4 py-2 bg-zinc-800">
                        <h1 class="text-xl font-black"><%= val %></h1>
                        <p class="text-sm mt-2">Details about the task can go here.</p>
                        <div class="flex justify-between mt-2">
                            <a class="text-sm text-red-600 font-semibold" href="/files/<%= val %>">/Read more</a>
                            <a class="text-sm text-slate-400 font-semibold" href="/edit/<%= val%>">Edit</a>
                        </div>    
                    </div>
                <% }) %>
            <% } else { %>
                <h1 class="text-white">No Task Yet</h1>    
            <% } %>
        </div>
    </div>
</body>
</html>